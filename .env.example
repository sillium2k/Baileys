# WhatsApp Group Link Monitor - Environment Configuration

# =============================================================================
# WEBHOOK API TOKEN (NEU - WICHTIG!)
# =============================================================================
# Token für die /send-message API Authentifizierung
# Generiere einen starken, zufälligen Token (mindestens 32 Zeichen)
# Beispiel: openssl rand -base64 32
WEBHOOK_API_TOKEN=your-secure-random-token-here

# =============================================================================
# WHATSAPP PAIRING CODE (optional)
# =============================================================================
# Telefonnummer für Pairing Code Methode (ohne + oder Leerzeichen)
# Nur wenn --use-pairing-code Flag verwendet wird
# Format: Landesvorwahl + Nummer (z.B. 4917123456789)
# WHATSAPP_PHONE_NUMBER=4917123456789

# =============================================================================
# SERVER KONFIGURATION
# =============================================================================
# Port für den HTTP Server (default: 3000)
# PORT=3000

# Environment (production oder development)
# NODE_ENV=production

# =============================================================================
# LOGGING (optional)
# =============================================================================
# DEBUG=true
# LOG_LEVEL=debug

# =============================================================================
# HINWEIS: Gruppen-Konfiguration
# =============================================================================
# Die Überwachung von Gruppen erfolgt jetzt über JSON-Dateien:
# - groups-config.json (Development)
# - groups-config.prod.json (Production)
#
# Siehe diese Dateien für die Konfiguration der überwachten Gruppen.